      "text": "are blocking needs edges: a bead with an open blocker is invisible to agents\nuntil that blocker closes",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "are blocking needs edges: a bead with an open blocker is invisible to agents until that blocker closes",
      "autoResize": false,
