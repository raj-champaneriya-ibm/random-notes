    {
      "id": "7PySxxBOJ81G7AjR1wmYr",
      "type": "text",
      "x": 23.127349853515625,
      "y": 316.78515625,
      "width": 179.99609375,
      "height": 280,
      "angle": 0,
      "strokeColor": "#fa5252",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
