    {
      "id": "wmwmiBiOeY56t70Hp8qZs",
      "type": "text",
      "x": 8198.360304797672,
      "y": 568.2555510194143,
      "width": 774.4393310546875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b25",
      "roundness": null,
      "seed": 1978274168,
      "version": 641,
      "versionNonce": 1291859795,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791351443085,
      "created": 1791200213281,
      "link": null,
      "locked": false,
      "text": "automates when a formula runs, pairing a trigger (cooldown, cron, condition,\nevent, or manual) with the formula to fire — no human runs a verb.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "automates when a formula runs, pairing a trigger (cooldown, cron, condition, event, or manual) with the formula to fire — no human runs a verb.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Q_gBZ-53l220hte2Nfmn8",
      "type": "text",
      "x": 7898.973366766767,
      "y": 744.2516134635764,
      "width": 1052.8832100054408,
      "height": 105,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b26",
      "roundness": null,
      "seed": 1251549816,
      "version": 619,
      "versionNonce": 190949597,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791351468749,
      "created": 1791200213281,
      "link": null,
      "locked": false,
      "text": "A formula is how a job gets done — a reusable, written-down method, a\nTOML file of steps and their dependencies. Applying it compiles the steps\ninto a graph and materializes them as beads",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A formula is how a job gets done — a reusable, written-down method, a TOML file of steps and their dependencies. Applying it compiles the steps into a graph and materializes them as beads",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
