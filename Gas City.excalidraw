      "text": "formula = workflow Architect's versioned right sized\nwork",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "formula = workflow Architect's versioned right sized work",
