    {
      "id": "iAujVhXd--JaGJiWN2IrS",
      "type": "text",
      "x": 9458.000426735627,
      "y": 575.441891239556,
      "width": 774.4393310546875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2w",
