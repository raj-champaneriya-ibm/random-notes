      "text": "Imports",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "28nxn50yYBR7TCC-3WIv2",
      "originalText": "Imports",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "6wyqYhhmyloOG2WU_vtin",
      "type": "text",
      "x": 13109.766375434961,
      "y": 412.04714119964996,
      "width": 779.6479735335137,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3c",
      "roundness": null,
      "seed": 938305427,
      "version": 1328,
      "versionNonce": 95933683,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791355983764,
      "created": 1791355821695,
      "link": null,
      "locked": false,
      "text": "The local (root) pack is your City: the pack rooted at the city directory,\nwhere the city keeps its own definitions alongside its deployment settings",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The local (root) pack is your City: the pack rooted at the city directory, where the city keeps its own definitions alongside its deployment settings",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "dq6Vab7aMrRd0cWcNxH5P",
      "type": "text",
      "x": 13112.300412597686,
      "y": 524.8326572119397,
      "width": 800,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3d",
      "roundness": null,
      "seed": 60882227,
      "version": 724,
      "versionNonce": 840067005,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791355983764,
      "created": 1791355821695,
      "link": null,
      "locked": false,
      "text": "named dependencies on shared packs; an imported pack’s agents, formulas, and\norders read exactly like locally declared ones, so a city reuses behavior defined\nelsewhere without copying files. The same engine becomes a different\norchestrator purely by swapping which packs it loads.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "named dependencies on shared packs; an imported pack’s agents, formulas, and orders read exactly like locally declared ones, so a city reuses behavior defined elsewhere without copying files. The same engine becomes a different orchestrator purely by swapping which packs it loads.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2Lk3AtWClEDpOb7b8Kq6W",
      "type": "line",
      "x": 13196.298360465638,
      "y": 383.0625606178343,
      "width": 224.45021938988793,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
