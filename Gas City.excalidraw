      "type": "text",
      "x": 9463.742643465504,
      "y": 656.5629854886082,
      "width": 764.2103525898107,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b30",
      "roundness": null,
      "seed": 1843547005,
      "version": 907,
      "versionNonce": 1005773523,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791352671327,
      "created": 1791352339095,
      "link": null,
      "locked": false,
      "text": "is one kind of order: each tick the orchestrator evaluates due triggers and\nfires them.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "is one kind of order: each tick the orchestrator evaluates due triggers and fires them.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "z0SQ8Z0TqLtgqdGWIm1Oz",
      "type": "text",
      "x": 9836.657570941165,
      "y": 354.95283459986007,
      "width": 446.9689591465915,
      "height": 50.28400790399156,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b31",
      "roundness": null,
      "seed": 1191588605,
      "version": 193,
      "versionNonce": 2127973555,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791352746548,
      "created": 1791352539752,
      "link": null,
      "locked": false,
      "text": "Agent scope is at agent level or agent\ninstance?",
      "fontSize": 20.11360316159662,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agent scope is at agent level or agent instance?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EjkRkIfHp4rmFcI3qjLKN",
      "type": "text",
      "x": 9162.798863985885,
      "y": 614.0466060104789,
      "width": 1065.3459931990456,
      "height": 175,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b32",
      "roundness": null,
      "seed": 1956619869,
      "version": 194,
      "versionNonce": 1921723069,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791352888750,
      "created": 1791352662871,
      "link": null,
      "locked": false,
      "text": "Its directory can live anywhere on disk, inside or outside the city. Isolation\nis by bead-ID prefix, not a separate database: the city and all its rigs share\none underlying store, and readd/writes are filtered to the current scope’s\nprefix. Work slung in one rig stays logically isolated from the others, and rig-\nscoped agents are instantiated once per rig.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Its directory can live anywhere on disk, inside or outside the city. Isolation is by bead-ID prefix, not a separate database: the city and all its rigs share one underlying store, and readd/writes are filtered to the current scope’s prefix. Work slung in one rig stays logically isolated from the others, and rig-scoped agents are instantiated once per rig.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "AnNg9iHkj2nHKU7KcYBoW",
      "type": "text",
      "x": 9778.611749229318,
      "y": 807.2208803241376,
      "width": 446.9689591465915,
      "height": 25.142003951995775,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
