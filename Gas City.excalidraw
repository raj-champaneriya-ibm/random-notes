    {
      "id": "dcNwjksEi7z0bTozQW_z1",
      "type": "text",
      "x": 2165.6001031786923,
      "y": 706.5573904442729,
      "width": 572.8061943463879,
      "height": 150,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 1610834952,
      "version": 426,
      "versionNonce": 1609173000,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791195822089,
      "created": 1791189791337,
      "link": null,
      "locked": false,
      "text": "In practice: you describe a feature once and come back to a\nfinished branch. The factory decomposes the work, implements\nthe pieces in parallel across agents, reviews the result, gap-\nchecks it against the plan, and fills what’s missing. The review\nand gap-check are how you get production quality; the parallel\nfan-out is the machine speed.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In practice: you describe a feature once and come back to a finished branch. The factory decomposes the work, implements the pieces in parallel across agents, reviews the result, gap-checks it against the plan, and fills what’s missing. The review and gap-check are how you get production quality; the parallel fan-out is the machine speed.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
