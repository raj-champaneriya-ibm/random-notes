    {
      "id": "3x6a1peIVgsAH0LUuXYn-",
      "type": "text",
      "x": 3035.1228252054916,
      "y": 649.8171566503249,
      "width": 306.71978759765625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1M",
