    },
    {
      "id": "hr7PVyYapUzcv6dsKC2PW",
      "type": "text",
      "x": 8205.527647189927,
      "y": 403.2468646755685,
      "width": 779.6479735335137,
      "height": 75,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 1702370936,
      "version": 1188,
      "versionNonce": 1581163059,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791351445733,
      "created": 1791200213281,
      "link": null,
      "locked": false,
      "text": "independent of the file and of any session. The orchestrator drives the run\noutside your session, fanning ready steps out to many agents at once and\ngating each on its dependencies",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "independent of the file and of any session. The orchestrator drives the run outside your session, fanning ready steps out to many agents at once and gating each on its dependencies",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "8G4L6d8mcJbxsfQV291wv",
      "type": "text",
      "x": 8202.781736877607,
      "y": 503.61682608206456,
      "width": 800,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b23",
      "roundness": null,
      "seed": 383618936,
      "version": 584,
      "versionNonce": 1738847421,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791351437416,
      "created": 1791200213281,
      "link": null,
      "locked": false,
      "text": "is the dispatch op that creates and routes in one motion.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "is the dispatch op that creates and routes in one motion.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
