      "index": "b3D",
      "roundness": null,
      "seed": 1273009469,
      "version": 1053,
      "versionNonce": 1046587475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791353600516,
      "created": 1791353149557,
      "link": null,
      "locked": false,
      "text": "The local (root) pack is your City: the pack rooted at the city directory,\nwhere the city keeps its own definitions alongside its deployment settings",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The local (root) pack is your City: the pack rooted at the city directory, where the city keeps its own definitions alongside its deployment settings",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "t1Wrt8ghM0SI46LCj9l4p",
      "type": "text",
      "x": 10659.3085403684,
      "y": 524.540031027776,
      "width": 800,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3E",
      "roundness": null,
      "seed": 620029341,
      "version": 449,
      "versionNonce": 1569214269,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791353503464,
      "created": 1791353149557,
      "link": null,
      "locked": false,
      "text": "named dependencies on shared packs; an imported pack’s agents, formulas, and\norders read exactly like locally declared ones, so a city reuses behavior defined\nelsewhere without copying files. The same engine becomes a different\norchestrator purely by swapping which packs it loads.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "named dependencies on shared packs; an imported pack’s agents, formulas, and orders read exactly like locally declared ones, so a city reuses behavior defined elsewhere without copying files. The same engine becomes a different orchestrator purely by swapping which packs it loads.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
