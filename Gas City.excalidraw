      "seed": 1501934077,
      "version": 798,
      "versionNonce": 1291586333,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791352671327,
      "created": 1791352339095,
      "link": null,
      "locked": false,
      "text": "automates when a formula runs, pairing a trigger (cooldown, cron, condition,\nevent, or manual) with the formula to fire — no human runs a verb.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "automates when a formula runs, pairing a trigger (cooldown, cron, condition, event, or manual) with the formula to fire — no human runs a verb.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "AKPxZJ0jWor4P2LqVEP9L",
      "type": "text",
      "x": 9166.310078204662,
      "y": 513.6360764931186,
      "width": 1052.8832100054408,
      "height": 70,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2x",
      "roundness": null,
      "seed": 559442525,
      "version": 856,
      "versionNonce": 1311139293,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791352674462,
      "created": 1791352339095,
      "link": null,
      "locked": false,
      "text": "A rig is where the work happens — an external project, usually a git repo,\nregistered with the city with gc rig add <path>",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A rig is where the work happens — an external project, usually a git repo, registered with the city with gc rig add <path>",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
