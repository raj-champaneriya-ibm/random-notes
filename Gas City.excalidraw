      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2u",
      "roundness": null,
      "seed": 1472732477,
      "version": 740,
      "versionNonce": 104885139,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791352671327,
      "created": 1791352339095,
      "link": null,
      "locked": false,
      "text": "is the dispatch op that creates and routes in one motion.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "is the dispatch op that creates and routes in one motion.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
