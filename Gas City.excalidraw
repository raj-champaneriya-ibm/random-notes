    {
      "id": "b9tja-2MthAYegecjud-_",
      "type": "text",
      "x": 10656.77450320567,
      "y": 411.75451501548633,
      "width": 779.6479735335137,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
