      "created": 1791199962740,
      "link": null,
      "locked": false,
      "text": "Ordering happens with no central scheduler as work persists in beads, the\nsystem converges: if an agent dies, its beads stay open and a fresh agent\npicks up the same work.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ordering happens with no central scheduler as work persists in beads, the system converges: if an agent dies, its beads stay open and a fresh agent picks up the same work.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
