    {
      "id": "YuIf_B_30GeEPZnQAkDQE",
      "type": "text",
      "x": 5703.50645587831,
      "y": 386.10429716507576,
      "width": 664.9365914439968,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1b",
      "roundness": null,
      "seed": 902751752,
      "version": 633,
      "versionNonce": 712003091,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791361784402,
      "created": 1791196403231,
      "link": null,
      "locked": false,
      "text": "a live process the platform can start, stop, prompt, and observe.\ninteractive conversations with agents, on-demand workers and\npersistent worker pools",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a live process the platform can start, stop, prompt, and observe.\ninteractive conversations with agents, on-demand workers and persistent worker pools",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jxOSI5of2DDtO7-J5lP5I",
      "type": "text",
      "x": 5702.646233221634,
      "y": 484.32230620609266,
      "width": 777.0228311653386,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1c",
      "roundness": null,
      "seed": 1421095544,
      "version": 161,
      "versionNonce": 446971123,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791361799160,
      "created": 1791196505564,
      "link": null,
      "locked": false,
      "text": "The engine backing that session is its provider when the orchestrator\nrestarts, it adopts the live sessions it finds — creating a session bead for\neach — rather than respawning them.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The engine backing that session is its provider when the orchestrator restarts, it adopts the live sessions it finds — creating a session bead for each — rather than respawning them.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Av96Lm_79ml2soB4HFbL-",
      "type": "line",
      "x": 5786.644181089583,
      "y": 349.0581234641359,
      "width": 224.45021938988793,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1f",
