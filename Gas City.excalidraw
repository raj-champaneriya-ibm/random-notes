    {
      "id": "wmwmiBiOeY56t70Hp8qZs",
      "type": "text",
      "x": 8198.520801321703,
      "y": 568.2555510194143,
      "width": 774.4393310546875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
