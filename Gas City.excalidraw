    {
      "id": "RXFVxrr_FeFXmN1_rAklq",
      "type": "text",
      "x": 2121.9466352492564,
      "y": 1228.8089629171977,
      "width": 718.939453125,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3u",
      "roundness": null,
      "seed": 1933881853,
      "version": 430,
      "versionNonce": 1876828157,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791361496015,
      "created": 1791357406383,
      "link": null,
      "locked": false,
      "text": "1. Brew install\n2. set alias gc->gasc\n3. Initailize city or Town\ngc init\n4. Troubleshoot\ngc doctor --fix\n5. gc status\n6. set up rig\n7. Review pack & agent\n8. Sling hello world task\ngc sling my-project/claude \"Write hello world in python to the file hello.py\"\n9. Watch Progress\ngc bd show mp-ff9 --watch\n\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Brew install\n2. set alias gc->gasc\n3. Initailize city or Town\ngc init\n4. Troubleshoot\ngc doctor --fix\n5. gc status\n6. set up rig\n7. Review pack & agent\n8. Sling hello world task\ngc sling my-project/claude \"Write hello world in python to the file hello.py\"\n9. Watch Progress\ngc bd show mp-ff9 --watch\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
