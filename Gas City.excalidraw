      "type": "line",
      "x": 8286.779684745556,
      "y": 354.1443829979746,
      "width": 224.45021938988793,
      "height": 0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
