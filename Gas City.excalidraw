      "link": null,
      "locked": false,
      "text": "A single agent can be scaled into a pool of identical workers sharing one queue",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single agent can be scaled into a pool of identical workers sharing one queue",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
