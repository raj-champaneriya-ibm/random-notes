      "text": "A rig carries a repo, its own bead namespace, and an agent scope.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A rig carries a repo, its own bead namespace, and an agent scope.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "_3GkrdnJs9o6MLUEePH45",
      "type": "text",
      "x": 9461.95331084242,
      "y": 511.0443307001452,
      "width": 800,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
