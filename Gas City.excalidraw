    {
      "id": "6JyEAs3INXUXkrMFZEujf",
      "type": "text",
      "x": 2196.1029754537462,
      "y": 561.8149200632192,
      "width": 511.80044979628065,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 50683656,
      "version": 316,
      "versionNonce": 1014744840,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791195822089,
      "created": 1791189493376,
      "link": null,
      "locked": false,
      "text": "orchestrator = runs formula across a fleet of agents,\noutside your session. It breaks the job into tracked units\nof work, runs the independent pieces in parallel, holds\nthe rest until their dependencies finish, and retries what\nfails until the whole thing is done. ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "orchestrator = runs formula across a fleet of agents, outside your session. It breaks the job into tracked units of work, runs the independent pieces in parallel, holds the rest until their dependencies finish, and retries what fails until the whole thing is done. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
