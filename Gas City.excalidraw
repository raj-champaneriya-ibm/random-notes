      "isDeleted": false,
      "boundElements": [],
      "updated": 1791200130603,
      "created": 1791199568443,
      "link": null,
      "locked": false,
      "text": "what the work is — one unit with an ID, title, status, and type, moving open\n→ in_progress → closed. Beads are also the universal store.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "what the work is — one unit with an ID, title, status, and type, moving open → in_progress → closed. Beads are also the universal store.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hziyBPTTEPPxdLgmTRxq5",
      "type": "text",
      "x": 6952.39121679991,
      "y": 504.2585903688869,
      "width": 800,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 1268723320,
      "version": 392,
      "versionNonce": 1205141000,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791200130603,
      "created": 1791199568443,
      "link": null,
      "locked": false,
      "text": "is a container bead that groups related work so you track a batch as a unit.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "is a container bead that groups related work so you track a batch as a unit.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
